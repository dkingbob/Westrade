{
  "framework": null,
  "buildCommand": "pnpm --filter @workspace/trading-dashboard build",
  "outputDirectory": "artifacts/trading-dashboard/dist/public",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://westrade.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
