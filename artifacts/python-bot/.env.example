# AlgoDesk Python Trading Bot — Environment Configuration
# Copy to .env and fill in your credentials

# Backend WebSocket URL (from the AlgoDesk dashboard)
ALGODESK_WS_URL=wss://your-replit-domain.replit.app/api/ws
ALGODESK_API_URL=https://your-replit-domain.replit.app/api

# MetaTrader 5 Credentials (Windows only)
MT5_ACCOUNT=123456
MT5_PASSWORD=your_mt5_password
MT5_SERVER=MetaQuotes-Demo

# Bot Mode: "paper" (simulated) or "live" (real MT5 trades)
BOT_MODE=paper

# Heartbeat interval in seconds
HEARTBEAT_INTERVAL=10

# Sentiment API Keys (optional)
TWITTER_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
NEWS_API_KEY=
